{
  "name": "claude-hooks-engine",
  "version": "0.2.2",
  "description": "Type-safe observer framework for Claude Code hook scripts",
  "author": "Maksym Mishchuk maxim.mishchuk@gmail.com",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./pre-tool-use": {
      "import": "./dist/src/core/hooks/pre-tool-use/index.js",
      "types": "./dist/src/core/hooks/pre-tool-use/index.d.ts"
    },
    "./stop": {
      "import": "./dist/src/core/hooks/stop/index.js",
      "types": "./dist/src/core/hooks/stop/index.d.ts"
    },
    "./subagent-start": {
      "import": "./dist/src/core/hooks/subagent-start/index.js",
      "types": "./dist/src/core/hooks/subagent-start/index.d.ts"
    },
    "./subagent-stop": {
      "import": "./dist/src/core/hooks/subagent-stop/index.js",
      "types": "./dist/src/core/hooks/subagent-stop/index.d.ts"
    },
    "./user-prompt-submit": {
      "import": "./dist/src/core/hooks/user-prompt-submit/index.js",
      "types": "./dist/src/core/hooks/user-prompt-submit/index.d.ts"
    },
    "./pre-compact": {
      "import": "./dist/src/core/hooks/pre-compact/index.js",
      "types": "./dist/src/core/hooks/pre-compact/index.d.ts"
    },
    "./post-tool-use": {
      "import": "./dist/src/core/hooks/post-tool-use/index.js",
      "types": "./dist/src/core/hooks/post-tool-use/index.d.ts"
    },
    "./notification": {
      "import": "./dist/src/core/hooks/notification/index.js",
      "types": "./dist/src/core/hooks/notification/index.d.ts"
    },
    "./session-start": {
      "import": "./dist/src/core/hooks/session-start/index.js",
      "types": "./dist/src/core/hooks/session-start/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/laurenci/claude-hooks-engine"
  },
  "keywords": ["claude", "claude-code", "hooks", "ai-hooks"],
  "scripts": {
    "build:js": "bun build ./index.ts ./src/core/hooks/pre-tool-use/index.ts ./src/core/hooks/stop/index.ts ./src/core/hooks/subagent-stop/index.ts ./src/core/hooks/user-prompt-submit/index.ts ./src/core/hooks/pre-compact/index.ts ./src/core/hooks/post-tool-use/index.ts ./src/core/hooks/notification/index.ts ./src/core/hooks/session-start/index.ts --outdir ./dist --target node --format esm",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run build:js && bun run build:types",
    "handler": "bun ./src/index.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@logtape/logtape": "^2.3.1"
  }
}
